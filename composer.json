{
    "name": "evgenijfaustov/debug-snapshot-bundle",
    "description": "Debug Snapshot Feature",
    "type": "symfony-bundle",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Evgenijfaustov\\DebugSnapshotBundle\\": "src/"
        }
    },
    "require": {
        "php": "^8.3",
        "symfony/framework-bundle": "^7.1",
        "symfony/console": "^7.1",
        "symfony/options-resolver": "^7.1",
        "symfony/filesystem": "^7.1",
        "symfony/serializer": "^7.1",
        "symfony/security-bundle": "^7.1",
        "doctrine/orm": "^2.17 || ^3.0",
      "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symfony/phpunit-bridge": "^7.1",
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "*",
        "rector/rector": "*",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "scripts": {
        "phpstan": "phpstan analyse -c phpstan.dist.neon --memory-limit=512M",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process --config=rector.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "evgenijfaustov",
            "email": "oooartint.evgenijfaustov@gmail.com"
        }
    ]
}
